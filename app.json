{
  "expo": {
    "name": "My Maths",
    "slug": "my-maths",
    "version": "1.0.0",
    "sdkVersion": "48.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#10b981",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow My Maths to access your photos to upload documents.",
          "cameraPermission": "Allow My Maths to use the camera to capture documents."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0aa1b3cb-8cc7-4a0e-aff7-dcd2f9ac6227"
      }
    },
    "android": {
      "package": "franklinleo.calculator",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "owner": "franklinleo311",
    "ios": {
      "bundleIdentifier": "franklinleo.calculator",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
